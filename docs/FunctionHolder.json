{
  "openapi": "3.0.0",
  "info": {
    "description": "This is a simple description for the PhoenixII Function Holder-API. The parameters {env} and {client} in the URL are needed. They represent the right environment and client for the API. These parameter will be given with API key.",
    "version": "1.3.4",
    "title": "Function Holder API",
    "contact": {
      "email": "phoenix-api@it4sport.de"
    }
  },
  "paths": {
    "/functions": {
      "get": {
        "tags": [
          "function-holder"
        ],
        "summary": "Show All Functions of the given Client",
        "description": "With this API call you will get all Functions that belong to your client that posess the given Function",
        "operationId": "showFunctions",
        "parameters": [
          {
            "name": "association_level",
            "in": "query",
            "description": "Use to specify which association level the Functions should have",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "The page number to retrieve",
            "schema": {
              "type": "number",
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "limits the amount of records per page",
            "schema": {
              "type": "number",
              "default": 25
            }
          }
        ],
        "security": [
          {
            "api_key": []
          }
        ],
        "responses": {
          "200": {
            "description": "successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/functionListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/function-holders": {
      "get": {
        "tags": [
          "function-holder"
        ],
        "summary": "Show All Persons with given function",
        "description": "With this API call you will get all Persons that belong to your client that posess the given Function",
        "operationId": "showPersons",
        "parameters": [
          {
            "name": "function_id",
            "in": "query",
            "description": "The unique identifiers of the functions to retrieve holders for.",
            "required": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid"
              }
            }
          },
          {
            "name": "club_id",
            "in": "query",
            "description": "Use to specify which club the Persons should belong to",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "district_id",
            "in": "query",
            "description": "Use to specify which district the People should belong to",
            "required": false,
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "county_id",
            "in": "query",
            "description": "Use to specify which district the People should belong to",
            "required": false,
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "association_id",
            "in": "query",
            "description": "Use to specify which association the People should belong to. Returns people from all a Associations if not given",
            "required": false,
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "Use to specify how the returned objects should be sorted",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "name"
              ],
              "default": "name"
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "The page number to retrieve",
            "schema": {
              "type": "number",
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "limits the amount of records per page",
            "schema": {
              "type": "number",
              "default": 25
            }
          }
        ],
        "security": [
          {
            "api_key": []
          }
        ],
        "responses": {
          "200": {
            "description": "successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PersonListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/board-member": {
      "get": {
        "tags": [
