            "name": "board_id",
            "in": "query",
            "description": "The unique identifiers of the boards to retrieve the members of",
            "required": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid"
              }
            }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "Use to specify how the returned objects should be sorted",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "name"
              ],
              "default": "name"
            }
          },
          {
            "name": "district_id",
            "in": "query",
            "description": "Use to specify which district the People should belong to",
            "required": false,
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "county_id",
            "in": "query",
            "description": "Use to specify which district the People should belong to",
            "required": false,
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "association_id",
            "in": "query",
            "description": "Use to specify which association the People should belong to. Returns people from all a Associations if not given",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "The page number to retrieve",
            "schema": {
              "type": "number",
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "limits the amount of records per page",
            "schema": {
              "type": "number",
              "default": 25
            }
          }
        ],
        "security": [
          {
            "api_key": []
          }
        ],
        "responses": {
          "200": {
            "description": "successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BoardMemberListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/association-level": {
      "get": {
        "tags": [
          "association-level"
        ],
        "summary": "Show All Levels of your Association",
        "description": "With this API call you will get all Association Levels of your client",
        "operationId": "showAssociationLevel",
        "parameters": [
          {
            "name": "association_level",
            "in": "query",
            "description": "The association Level to retrieve.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "The page number to retrieve",
            "schema": {
              "type": "number",
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "limits the amount of records per page",
            "schema": {
              "type": "number",
              "default": 25
            }
          }
        ],
        "security": [
          {
            "api_key": []
          }
        ],
        "responses": {
          "200": {
            "description": "successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssociationLevelListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/boards": {
      "get": {
        "tags": [
          "board"
        ],
        "summary": "Show All Boards",
        "description": "With this API call you will get all Boards that belong to your client",
        "operationId": "showBoards",
        "parameters": [
          {
            "name": "sort",
            "in": "query",
            "description": "Use to specify how the returned objects should be sorted",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "description"
              ],
              "default": "description"
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "The page number to retrieve",
            "schema": {
              "type": "number",
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "limits the amount of records per page",
            "schema": {
              "type": "number",
              "default": 25
            }
          },
          {
            "name": "association_level",
            "in": "query",
            "description": "which association level to retrieve boards of.",
            "schema": {
              "type": "number"
            }
          }
        ],
        "security": [
          {
            "api_key": []
          }
        ],
        "responses": {
          "200": {
            "description": "successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BoardListResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "https://{env}{client}.it4sport.de/api/",
      "variables": {
        "env": {
          "description": "This is the environment you will call the API",
          "default": "dev",
          "enum": [
            "test",
            "testing",
            "dev"
          ]
        },
        "client": {
          "description": "This is the client you will call the API",
          "default": "webinar"
        }
      }
    }
  ],
  "components": {
    "securitySchemes": {
      "api_key": {
        "type": "apiKey",
        "name": "X-Auth-Token",
        "in": "header"
      }
    },
